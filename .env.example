# Salin jadi .env (atau set di hosting), lalu ganti nilainya
JWT_SECRET=isi-string-acak-yang-panjang
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-password-admin
PORT=3000
# Saat dipasang di hosting, set juga:
# NODE_ENV=production   (mengaktifkan cookie HTTPS-only dan pemeriksaan wajib JWT_SECRET & ADMIN_PASSWORD)
