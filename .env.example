# Secret JWT acak minimal 32 karakter. Jangan commit file .env asli.
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Akun admin hanya dipakai saat database remote belum memiliki akun admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-dengan-password-admin-yang-kuat

# Dibuat dari dashboard Turso. Isi di .env lokal jika ingin uji koneksi remote.
TURSO_DATABASE_URL=libsql://nama-database-nama-akun.turso.io
TURSO_AUTH_TOKEN=isi-token-database

PORT=3000
